	spawn(function() --Source for Script12
		local script = Script12
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		
		local LocalPlayer = Players.LocalPlayer
		local Button = script.Parent
		
		--// SETTINGS
		local MAX_DISTANCE = 1000
		
		local ESP_COLOR = Color3.fromRGB(255, 0, 0)
		local ON_COLOR = Color3.fromRGB(50, 200, 80)
		
		--// Save the button's original color
		local NORMAL_COLOR = Button.BackgroundColor3
		
		local ESP_ENABLED = false
		local ESPObjects = {}
		
		Button.Text = 
		
		
		--// Check whether a player is a valid enemy
		local function isEnemy(player)
			if player == LocalPlayer then
				return false
			end
		
			-- Ignore teammates
			if LocalPlayer.Team ~= nil and player.Team ~= nil then
				if LocalPlayer.Team == player.Team then
					return false
				end
			end
		
			local character = player.Character
			if not character then
				return false
			end
		
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")
			local head = character:FindFirstChild("Head")
		
			if not humanoid or not root or not head then
				return false
			end
		
			-- Ignore dead players
			if humanoid.Health <= 0 then
				return false
			end
		
			return true
		end
		
		
		--// Remove ESP from a player
		local function removeESP(player)
			local objects = ESPObjects[player]
		
			if objects then
				if objects.highlight then
					objects.highlight:Destroy()
				end
		
				if objects.billboard then
					objects.billboard:Destroy()
				end
		
				ESPObjects[player] = nil
			end
		end
		
		
		--// Create ESP for a player
		local function createESP(player)
			if not isEnemy(player) then
				return
			end
		
			local character = player.Character
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local head = character:FindFirstChild("Head")
		
			if not head or not humanoid then
				return
			end
		
			-- Remove old ESP first
			removeESP(player)
		
			--// RED CHARACTER HIGHLIGHT
			local highlight = Instance.new("Highlight")
			highlight.Name = "EnemyESP"
			highlight.Adornee = character
		
			highlight.FillColor = ESP_COLOR
			highlight.OutlineColor = ESP_COLOR
		
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
		
			-- Visible through walls
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		
			highlight.Parent = character
		
		
			--// NAME + HP DISPLAY
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "EnemyESPInfo"
			billboard.Adornee = head
		
			billboard.Size = UDim2.new(0, 250, 0, 45)
			billboard.StudsOffset = Vector3.new(0, 3, 0)
		
			billboard.AlwaysOnTop = true
			billboard.MaxDistance = MAX_DISTANCE
		
			billboard.Parent = head
		
		
			-- Container
			local container = Instance.new("Frame")
			container.Size = UDim2.fromScale(1, 1)
			container.BackgroundTransparency = 1
			container.Parent = billboard
		
		
			-- Username
			local nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "Username"
		
			nameLabel.Size = UDim2.new(0.65, 0, 1, 0)
			nameLabel.Position = UDim2.new(0, 0, 0, 0)
		
			nameLabel.BackgroundTransparency = 1
		
			nameLabel.Text = player.Name
			nameLabel.TextColor3 = ESP_COLOR
		
			nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			nameLabel.TextStrokeTransparency = 0
		
			nameLabel.TextScaled = true
			nameLabel.Font = Enum.Font.SourceSansBold
		
			nameLabel.Parent = container
		
		
			-- HP
			local hpLabel = Instance.new("TextLabel")
			hpLabel.Name = "Health"
		
			hpLabel.Size = UDim2.new(0.35, 0, 1, 0)
			hpLabel.Position = UDim2.new(0.65, 0, 0, 0)
		
			hpLabel.BackgroundTransparency = 1
		
			hpLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
		
			hpLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			hpLabel.TextStrokeTransparency = 0
		
			hpLabel.TextScaled = true
			hpLabel.Font = Enum.Font.SourceSansBold
		
			hpLabel.Parent = container
		
		
			-- Store objects
			ESPObjects[player] = {
				highlight = highlight,
				billboard = billboard,
				humanoid = humanoid,
				hpLabel = hpLabel
			}
		end
		
		
		--// Update ESP
		local function updateESP()
			if not ESP_ENABLED then
				return
			end
		
			local myCharacter = LocalPlayer.Character
			local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
		
			if not myRoot then
				return
			end
		
			for _, player in ipairs(Players:GetPlayers()) do
		
				if player ~= LocalPlayer then
		
					local character = player.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		
					-- Check team
					local sameTeam = false
		
					if LocalPlayer.Team ~= nil and player.Team ~= nil then
						sameTeam = LocalPlayer.Team == player.Team
					end
		
					if root
						and humanoid
						and humanoid.Health > 0
						and not sameTeam then
		
						local distance =
							(root.Position - myRoot.Position).Magnitude
		
						if distance <= MAX_DISTANCE then
		
							-- Create ESP if it doesn't exist
							if not ESPObjects[player] then
								createESP(player)
							end
		
							-- Update HP
							local objects = ESPObjects[player]
		
							if objects and objects.hpLabel then
		
								local health = math.floor(humanoid.Health)
								local maxHealth = math.floor(humanoid.MaxHealth)
		
								objects.hpLabel.Text =
									"HP: " .. health .. "/" .. maxHealth
		
								-- Change HP color based on health
								local healthPercent =
									humanoid.Health / humanoid.MaxHealth
		
								if healthPercent > 0.6 then
									objects.hpLabel.TextColor3 =
										Color3.fromRGB(0, 255, 0)
		
								elseif healthPercent > 0.3 then
									objects.hpLabel.TextColor3 =
										Color3.fromRGB(255, 255, 0)
		
								else
									objects.hpLabel.TextColor3 =
										Color3.fromRGB(255, 50, 50)
								end
							end
		
						else
							-- Too far away
							removeESP(player)
						end
		
					else
						-- Dead, teammate, or invalid
						removeESP(player)
					end
				end
			end
		end
		
		
		--// Toggle ESP
		Button.MouseButton1Click:Connect(function()
		
			ESP_ENABLED = not ESP_ENABLED
		
			if ESP_ENABLED then
		
				-- Green button
				Button.BackgroundColor3 = ON_COLOR
				Button.Text = 
		
				updateESP()
		
			else
		
				-- Restore original button color
				Button.BackgroundColor3 = NORMAL_COLOR
				Button.Text = 
		
				-- Remove all ESP
				for player in pairs(ESPObjects) do
					removeESP(player)
				end
			end
		end)
		
		
		--// Continuously update ESP
		RunService.Heartbeat:Connect(function()
			if ESP_ENABLED then
				updateESP()
			end
		end)
		
		
		--// Clean up when players leave
		Players.PlayerRemoving:Connect(function(player)
			removeESP(player)
		end)
	end)
