local function QQEI_fake_script() -- FRIENDESPBUTTON.LocalScript 
	local script = Instance.new('LocalScript', FRIENDESPBUTTON)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local LocalPlayer = Players.LocalPlayer
	local Button = script.Parent
	
	local FRIEND_COLOR = Color3.fromRGB(50, 255, 80)
	local ON_COLOR = Color3.fromRGB(50, 200, 80)
	
	local NORMAL_COLOR = Button.BackgroundColor3
	local ENABLED = false
	
	local friendESP = {}
	
	
	-- Check whether a player is a Roblox friend
	local function isFriend(player)
		if player == LocalPlayer then
			return false
		end
	
		local success, result = pcall(function()
			return LocalPlayer:IsFriendsWith(player.UserId)
		end)
	
		return success and result
	end
	
	
	-- Remove ESP
	local function removeESP(player)
		local data = friendESP[player]
	
		if data then
			if data.highlight then
				data.highlight:Destroy()
			end
	
			if data.billboard then
				data.billboard:Destroy()
			end
	
			friendESP[player] = nil
		end
	end
	
	
	-- Create ESP
	local function createESP(player)
		if not ENABLED or not isFriend(player) then
			return
		end
	
		local character = player.Character
		if not character then
			return
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head")
	
		if not humanoid or not head or humanoid.Health <= 0 then
			return
		end
	
		removeESP(player)
	
	
		-- Green character highlight
		local highlight = Instance.new("Highlight")
	
		highlight.Adornee = character
	
	
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
	
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	
		highlight.Parent = character
	
	
		-- Name + HP display
		local billboard = Instance.new("BillboardGui")
	
		billboard.Name = "FriendESPInfo"
		billboard.Adornee = head
	
		billboard.Size = UDim2.new(0, 240, 0, 45)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
	
		billboard.AlwaysOnTop = true
		billboard.Parent = head
	
	
		local label = Instance.new("TextLabel")
	
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
	
		label.TextColor3 = FRIEND_COLOR
	
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextStrokeTransparency = 0
	
		label.TextScaled = true
		label.Font = Enum.Font.SourceSansBold
	
		label.Parent = billboard
	
	
		friendESP[player] = {
			highlight = highlight,
			billboard = billboard,
			humanoid = humanoid,
			label = label
		}
	end
	
	
	-- Update ESP
	local function updateESP()
		if not ENABLED then
			return
		end
	
		for _, player in ipairs(Players:GetPlayers()) do
	
			if player ~= LocalPlayer then
	
				if isFriend(player) then
	
					local character = player.Character
					local humanoid = character
						and character:FindFirstChildOfClass("Humanoid")
					local head = character
						and character:FindFirstChild("Head")
	
					if humanoid
						and head
						and humanoid.Health > 0 then
	
						if not friendESP[player] then
							createESP(player)
						end
	
						local data = friendESP[player]
	
						if data and data.label then
							local hp = math.floor(humanoid.Health)
							local maxHP = math.floor(humanoid.MaxHealth)
	
							data.label.Text =
								player.Name
								.. "   HP: "
								.. hp
								.. "/"
								.. maxHP
						end
	
					else
						removeESP(player)
					end
	
				else
					removeESP(player)
				end
			end
		end
	end
	
	
	-- Toggle button
	Button.Activated:Connect(function()
	
		ENABLED = not ENABLED
	
		if ENABLED then
	
			Button.BackgroundColor3 = ON_COLOR
	
			updateESP()
	
		else
	
			Button.BackgroundColor3 = NORMAL_COLOR
	
			for player in pairs(friendESP) do
				removeESP(player)
			end
		end
	end)
	
	
	-- Continuously update
	RunService.Heartbeat:Connect(function()
		if ENABLED then
			updateESP()
		end
	end)
	
	
	-- Remove ESP when player leaves
	Players.PlayerRemoving:Connect(function(player)
		removeESP(player)
	end)
end
