	spawn(function() --Source for Script26
		local script = Script26
		local UserInputService = game:GetService("UserInputService")
		
		local frame = script.Parent
		
		-- How tall the draggable top area is
		local DRAG_HEIGHT = 40
		
		local dragging = false
		local dragStart
		local startPosition
		
		local function updateDrag(input)
			local delta = input.Position - dragStart
		
			frame.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
		
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
		
				local mousePosition = input.Position
				local frameTop = frame.AbsolutePosition.Y
		
				-- Only allow dragging from the top of the Frame
				if mousePosition.Y <= frameTop + DRAG_HEIGHT then
					dragging = true
					dragStart = input.Position
					startPosition = frame.Position
				end
			end
		end)
		
		frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				UserInputService.InputChanged:Connect(function(changedInput)
					if dragging and changedInput == input then
						updateDrag(changedInput)
					end
				end)
			end
		end)
		
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)
	end)
